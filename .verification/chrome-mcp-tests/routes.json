    "internal": {
      "description": "Internal/development pages (not for production testing)",
      "routes": [
        {
          "path": "/design-pilot",
          "name": "Design Pilot",
          "internal": true,
          "testScrollPosition": false
        }
      ]
    }
  },
  "testGroups": {
    "smoke": {
      "description": "Quick smoke test - critical pages only",
      "include": ["critical"]
    },
    "full": {
      "description": "Full test - all public pages",
      "include": ["critical", "lessons", "activities", "activitiesNested", "projects", "other"]
    },
    "lessons-only": {
      "description": "Test only lesson pages",
      "include": ["lessons"]
    },
    "activities-only": {
      "description": "Test only activity pages",
      "include": ["activities", "activitiesNested"]
    },
    "canvas-activities": {
      "description": "Activities with canvas/WebGL elements",
      "filter": {
        "hasCanvas": true
      }
    }
  },
  "scrollPositionCheck": {
    "description": "After navigation, verify window.scrollY equals expected value",
    "expectedValue": 0,
    "tolerance": 50,
    "checkDelay": 500
  }
}
