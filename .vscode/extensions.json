{
  "recommendations": [
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // Recommended VS Code Extensions for AI Kids Spark Learn
    // Install these for the best development experience with automatic verification
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    // ───────────────────────────────────────────────────────────────────────────────
    // Essential (Required for verification system)
    // ───────────────────────────────────────────────────────────────────────────────
    "dbaeumer.vscode-eslint",          // ESLint - Real-time code quality
    "esbenp.prettier-vscode",          // Prettier - Code formatting
    "bradlc.vscode-tailwindcss",       // Tailwind CSS IntelliSense

    // ───────────────────────────────────────────────────────────────────────────────
    // TypeScript & React
    // ───────────────────────────────────────────────────────────────────────────────
    "vscode.typescript-language-features", // TypeScript support
    "dsznajder.es7-react-js-snippets",     // React snippets
    "styled-components.vscode-styled-components", // Styled components support

    // ───────────────────────────────────────────────────────────────────────────────
    // Testing & Debugging
    // ───────────────────────────────────────────────────────────────────────────────
    "ms-playwright.playwright",        // Playwright Test for VS Code
    "vitest.explorer",                 // Vitest Test Explorer

    // ───────────────────────────────────────────────────────────────────────────────
    // Accessibility (Important for Kids Platform)
    // ───────────────────────────────────────────────────────────────────────────────
    "deque-systems.vscode-axe-linter", // Axe Accessibility Linter
    "streetsidesoftware.code-spell-checker", // Spell checker

    // ───────────────────────────────────────────────────────────────────────────────
    // Git & Version Control
    // ───────────────────────────────────────────────────────────────────────────────
    "eamodio.gitlens",                 // GitLens - Git supercharged
    "mhutchie.git-graph",              // Git Graph

    // ───────────────────────────────────────────────────────────────────────────────
    // Productivity
    // ───────────────────────────────────────────────────────────────────────────────
    "christian-kohler.path-intellisense", // Path autocomplete
    "formulahendry.auto-rename-tag",      // Auto rename HTML/JSX tags
    "naumovs.color-highlight",            // Color highlighting in code
    "aaron-bond.better-comments",         // Better comment highlighting
    "usernamehw.errorlens",              // Error highlighting inline

    // ───────────────────────────────────────────────────────────────────────────────
    // Markdown & Documentation
    // ───────────────────────────────────────────────────────────────────────────────
    "yzhang.markdown-all-in-one",      // Markdown support
    "bierner.markdown-preview-github-styling", // GitHub markdown preview

    // ───────────────────────────────────────────────────────────────────────────────
    // Code Quality & Performance
    // ───────────────────────────────────────────────────────────────────────────────
    "wix.vscode-import-cost",          // Display import cost
    "mikestead.dotenv",                // .env file support
    "editorconfig.editorconfig",       // EditorConfig support

    // ───────────────────────────────────────────────────────────────────────────────
    // UI Enhancement
    // ───────────────────────────────────────────────────────────────────────────────
    "pkief.material-icon-theme",       // Material Icon Theme
    "github.github-vscode-theme"       // GitHub Theme
  ],

  "unwantedRecommendations": [
    // Extensions that might conflict with the verification system
    "hookyqr.beautify",                // Conflicts with ESLint formatter
    "rvest.vs-code-prettier-eslint"    // Redundant with our setup
  ]
}
